{
  "name": "choco-pi-hooks",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code-compatible lifecycle hooks for choco-pi.",
  "keywords": [
    "claude-code",
    "hooks",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
