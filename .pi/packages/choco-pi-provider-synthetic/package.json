{
  "name": "choco-pi-provider-synthetic",
  "version": "0.1.0",
  "private": false,
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-synthetic"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "!src/**/*.test.ts",
    "!extensions/**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish"
  },
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.15.0",
    "@aliou/pi-utils-ui": "^0.4.0"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.11.0",
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "tsx": "^4.19.0",
    "typebox": "^1.1.37",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.8",
    "@earendil-works/pi-coding-agent": ">=0.80.8",
    "@earendil-works/pi-tui": ">=0.80.8",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-coding-agent",
      "@earendil-works/pi-tui": "$@earendil-works/pi-coding-agent"
    }
  },
  "chocoPi": {
    "supersedes": [
      "@aliou/pi-synthetic",
      "pi-synthetic"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts",
      "./extensions/web-search/index.ts",
      "./extensions/command-quotas/index.ts",
      "./extensions/sub-bar-integration/index.ts",
      "./extensions/quota-warnings/index.ts",
      "./extensions/usage-status/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-synthetic/demo.mp4",
    "image": "https://assets.aliou.me/github/aliou/pi-synthetic/banner.png"
  }
}
