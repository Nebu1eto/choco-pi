{
	"name": "choco-pi-codex",
	"version": "3.0.18-choco.0",
	"private": true,
	"type": "module",
	"description": "choco-pi fork of @howaboua/pi-codex-conversion: Codex tool and prompt adapter with OpenAI server-side compaction, loaded from TypeScript source as a local pi package.",
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"codex",
		"adapter",
		"apply-patch"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.84.2",
		"@earendil-works/pi-ai": ">=0.84.2",
		"@earendil-works/pi-coding-agent": ">=0.84.2",
		"@earendil-works/pi-tui": ">=0.84.2",
		"typebox": "*"
	},
	"dependencies": {
		"base64-js": "1.5.1",
		"js-tiktoken": "1.0.21",
		"openai": "6.26.0",
		"partial-json": "0.1.7",
		"proxy-from-env": "1.1.0",
		"smol-toml": "1.7.1",
		"tree-sitter-bash": "0.25.1",
		"undici": "8.10.0",
		"web-tree-sitter": "0.26.12"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
