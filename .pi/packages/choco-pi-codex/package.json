{
  "name": "choco-pi-codex",
  "version": "0.1.0",
  "private": true,
  "description": "choco-pi fork of @howaboua/pi-codex-conversion: Codex tool and prompt adapter with OpenAI server-side compaction, loaded from TypeScript source as a local pi package.",
  "keywords": [
    "adapter",
    "apply-patch",
    "codex",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "base64-js": "1.5.1",
    "js-tiktoken": "1.0.21",
    "openai": "6.26.0",
    "partial-json": "0.1.7",
    "proxy-from-env": "1.1.0",
    "smol-toml": "1.7.1",
    "tree-sitter-bash": "0.25.1",
    "undici": "8.10.0",
    "web-tree-sitter": "0.26.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.2",
    "@earendil-works/pi-ai": ">=0.84.2",
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.84.2",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
