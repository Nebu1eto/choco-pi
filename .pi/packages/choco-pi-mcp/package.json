{
  "name": "choco-pi-mcp",
  "version": "0.1.0",
  "description": "Native Figma design extension for choco-pi; MCP is provided by Pi",
  "license": "MIT",
  "files": [
    "figma",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./figma/index.ts",
  "exports": {
    ".": {
      "types": "./figma/index.ts",
      "import": "./figma/index.ts",
      "default": "./figma/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@napi-rs/keyring": "^1.3.0",
    "@standard-schema/spec": "1.1.0",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "typebox": "^1.3.29"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0",
  "chocoPi": {
    "supersedes": [
      "pi-mcp-adapter",
      "pi-mono-figma"
    ]
  },
  "pi": {
    "extensions": [
      "./figma/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
