    "pi",
    "pi-extension",
    "pi-package",
    "subdir-context"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "typebox": ">=1.3.12"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
