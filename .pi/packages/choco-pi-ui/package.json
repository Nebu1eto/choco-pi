{
  "name": "choco-pi-ui",
  "version": "0.1.0",
  "description": "choco-pi's TUI package: Starship-style footer, Opencode-style editor, and the Nord themes.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi-theme",
    "starship",
    "tui"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "themes"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "pi:dev": "${PI_BIN:-/opt/homebrew/bin/pi} --no-extensions -e ./extensions/zentui/index.ts",
    "pi:install-local": "${PI_BIN:-/opt/homebrew/bin/pi} install ./ -l",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run verify && npm run pack:check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^26.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1"
  },
  "chocoPi": {
    "supersedes": [
      "pi-zentui",
      "@maddeye/pi-nord"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  }
}
