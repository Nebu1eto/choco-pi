{
  "name": "@choco-pi/subagents",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "choco-pi fork of @tintinweb/pi-subagents: Claude Code-style autonomous sub-agents for pi, loaded from TypeScript source as a local pi package.",
  "keywords": [
    "agent",
    "autonomous",
    "pi",
    "pi-extension",
    "pi-package",
    "subagent"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "croner": "10.0.1",
    "nanoid": "5.1.16"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "~1.6.0",
    "@earendil-works/pi-coding-agent": "~1.6.0",
    "@earendil-works/pi-schema": "~1.6.0",
    "@earendil-works/pi-tui": "~1.6.0",
    "typebox": "^1.3.29"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "chocoPi": {
    "supersedes": [
      "@tintinweb/pi-subagents",
      "pi-btw"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
