{
  "name": "@choco-pi/codex",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "choco-pi fork of @howaboua/pi-codex-conversion: Codex tool and prompt adapter with OpenAI server-side compaction, loaded from TypeScript source as a local pi package.",
  "keywords": [
    "adapter",
    "apply-patch",
    "codex",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@choco-pi/code-mode": "workspace:*",
    "@choco-pi/shared": "workspace:*",
    "base64-js": "1.5.1",
    "js-tiktoken": "1.0.21",
    "openai": "6.26.0",
    "partial-json": "0.1.7",
    "proxy-from-env": "1.1.0",
    "undici": "8.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "~1.6.0",
    "@earendil-works/pi-ai": "~1.6.0",
    "@earendil-works/pi-coding-agent": "~1.6.0",
    "@earendil-works/pi-schema": "~1.6.0",
    "@earendil-works/pi-tui": "~1.6.0",
    "typebox": "^1.3.29"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "chocoPi": {
    "supersedes": [
      "@howaboua/pi-codex-conversion"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
