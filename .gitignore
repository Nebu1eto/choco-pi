# Pi installs project packages from .pi/settings.json on demand.
.pi/npm/
.pi/git/

# Pi runtime state, caches, credentials, and local extension settings.
.pi/agent/
.pi/auth.json
.pi/models-store.json
.pi/markdown-workflows.json
.pi/extensions/synthetic.json
.pi/mcp-traces/
.pi/subagent-schedules/

# Never commit local credentials or environment overrides.
.env
.env.*
!.env.example
*.local
